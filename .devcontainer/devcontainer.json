{
  "name": "VoiceSadhana",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [4173],
  "portsAttributes": {
    "4173": {
      "label": "VoiceSadhana",
      "onAutoForward": "openPreview",
      "visibility": "private"
    }
  },
  "postCreateCommand": "npm test",
  "postStartCommand": "bash .devcontainer/start-app.sh",
  "postAttachCommand": "bash .devcontainer/start-app.sh",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint"]
    }
  }
}
